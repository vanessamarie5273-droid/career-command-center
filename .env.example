# Copy to .env for local development. Never commit real values.

# Postgres connection string (Render sets this automatically from the database).
DATABASE_URL="postgresql://postgres@localhost:5432/ccc"

# Signs session cookies. At least 32 random characters: `openssl rand -base64 48`
SESSION_SECRET=""

# Bearer token for /api/cron/daily (only needed if you use an HTTP scheduler).
CRON_SECRET=""

# Public URL of the app, used in email links.
APP_URL="http://localhost:3000"

# Optional: email alerts and the morning briefing via Resend (resend.com).
RESEND_API_KEY=""
ALERT_FROM_EMAIL=""

# Optional: the assistant and resume tailoring suggestions.
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"

# Used once by `npm run user:create` to create or reset your login.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
